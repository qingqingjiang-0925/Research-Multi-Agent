# ===== LLM 配置 =====
# OpenAI 兼容接口：DeepSeek / Qwen / 本地 Ollama / OpenRouter 均可，留空 base 则用官方 OpenAI
LLM_PROVIDER=openai
OPENAI_API_BASE=https://llm-fnnif09n0vocc5jc.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
OPENAI_API_KEY=sk-你的key
MODEL_NAME=qwen3.8-max

# ===== 搜索工具 =====
# 留空则自动降级到 DuckDuckGo HTML 后端（零 key 可用）
SEARCH_BACKEND=tavily
TAVILY_API_KEY=

# ===== 流程控制（防死循环 / 控成本）=====
MAX_SEARCH_ROUNDS=3
MAX_REVISION_ROUNDS=2
REVIEW_PASS_SCORE=0.75
MAX_SUBTASKS=6
MIN_EVIDENCE_PER_SUBTASK=2

# ===== 输出 =====
LOG_LEVEL=INFO
SAVE_REPORT=true